def thread(short):
    name = agent(short).get("name", "")
    t = next((t for t in THREADS if t["key"] in name), THREADS[0])
    key = t["key"]
    log = world(f"thread-{key}.log")
    s = Screen(log)
    if read(log):
        s.replay()
    else:
        header(s, f"Claude Code · thread {t['title']}",
               f"cwd: ~/work/payments-api/.claude/worktrees/{name}")
        s.user(t["task"])
        for call, result in THREAD_WORK[key]:
            s.tool(call, result)
        if key == "flaky-checkout-test":
            s.say("Opened PR #482. The cart fixture seeded the cart before the inventory "
                  "mock reserved stock, so the total was 0 about one run in five. 50 runs "
                  "pass in a row now.")
    if key == "rate-limiting" and not os.path.exists(world("answered")):
        s.say("Before I wire it in: what limit should each API key get?")
        answer = ask(s, "Limit", "What limit should each API key get?",
                     ["100 requests a minute (Recommended)", "1,000 requests a minute",
                      "By plan: free 60, pro 600"])
        write(world("answered"), answer)
        s.line(f"  {GRAY}⎿  {answer}{RESET}")
        set_state(short, "working", "busy")
        limit = answer.split(" requests")[0].replace(",", "_")
        mount = f"rateLimit({{ perMinute: {limit} }})" if "plan" not in answer else "rateLimit.byPlan()"
        s.tool(("Update", "src/api/router.ts"), f"Mounted {mount} on /v1")
    if agent(short).get("status") == "busy":
        verbs = {"rate-limiting": "Writing tests", "speed-up-search": "Profiling"}
        s.line()
        s.spin(verbs.get(key, "Working"), 10**6)
    while True:
        s.key(1)


def ask(s, label, question, options):
    """Claude Code's question picker; returns the option picked with Enter or its number."""
    pick = 0

    def draw(first):
        if not first:
            s.emit(f"\x1b[{len(options) + 3}A")
        s.emit(f"\r\x1b[K  {BLUE}☐ {label}{RESET}\n\r\x1b[K  {BOLD}{question}{RESET}\n")
        for i, o in enumerate(options):
            mark = f"{BLUE}❯{RESET}" if i == pick else " "
            colour = BLUE if i == pick else WHITE
            s.emit(f"\r\x1b[K  {mark} {colour}{i + 1}. {o}{RESET}\n")
        s.emit(f"\r\x1b[K  {GRAY}Enter to select · ↑↓ to navigate · Esc to cancel{RESET}\n")

    s.line(keep=False)
    draw(True)
    while True:
        k = s.key(0.2)
        if k in ("\r", "\n"):
            break
        if k and k.isdigit() and 1 <= int(k) <= len(options):
            pick = int(k) - 1
            draw(False)
            time.sleep(0.3)
            break
        if k == "\x1b":
            seq = (s.key(0.05) or "") + (s.key(0.05) or "")
            step = {"B": 1, "A": -1}.get(seq[-1:], 0)
            pick = (pick + step) % len(options)
            draw(False)
    # The picker's lines go; the answer stays, as in Claude Code.
    s.emit(f"\x1b[{len(options) + 3}A\x1b[J")
    s.box("")
    s.line(f"{GREEN}⏺{RESET} {BOLD}User answered{RESET}{GRAY}({label}){RESET}")
    return options[pick].replace(" (Recommended)", "")


def director():
    """The threads' timeline after they start: the flaky test opens a PR, rate limiting asks."""
    flaky, rate = short_of("flaky-checkout-test"), short_of("rate-limiting")
    branch = f"worktree-{agent(flaky)['name']}"
    time.sleep(4)
    subprocess.run(["bash", "-c", f'. "{DEMO}/lib.sh"; pr_set "{branch}" "" 482'])
    time.sleep(3.5)
    set_state(rate, "blocked", "waiting")
    post(["Rate limiting needs you: it asks what limit each API key should get. "
          "Open it from the board to answer."])
    # The board polls pull requests every 30 s. The thread ends its turn once the board has
    # seen the PR, so it goes from Working straight to Ready for review.
    give_up = time.time() + 120
    while not os.path.exists(world("pr", branch + ".served")):
        if time.time() > give_up or not os.path.isdir(WORLD):
            return
        time.sleep(0.2)
    set_state(flaky, "done", "idle")
    time.sleep(1.5)
    post(["Flaky checkout test has PR #482 up for review. The cart fixture seeded the cart "
          "before the inventory mock reserved stock; it waits for the reservation now, and "
          "50 runs in a row pass."])


def main():
    if sys.argv[1:] == ["director"]:
        director()
        return
    short = sys.argv[1]
    if agent(short).get("name", "").startswith("chief-"):
        coordinator(short)
    else:
        thread(short)


if __name__ == "__main__":
    main()
